# Copiá a .env (nunca se commitea; en Orca lo restaura el hook de worktree).
# NEXT_PUBLIC_EJEMPLO=hola

# Quién llama: lautaro, agustin, luciano, demo o test. Sin esto, el registro dice "desconocido".
STOCKPROOF_CALLER=
# Desde dónde: local o ci.
STOCKPROOF_ENV=local
# Carpeta del registro de llamadas. Por defecto, logs/.
# STOCKPROOF_LOG_DIR=logs

# Nodo JSON-RPC de BSC mainnet para leer supportsInterface (pregunta 1, BEP-8056). No es Binance.
# Por ejemplo https://bsc-dataseed.bnbchain.org
BSC_RPC_URL=

# Credenciales de la API web3 de Binance (portal de desarrolladores). Solo el servidor las lee;
# sin ellas la evaluación corre en modo público y las cotizaciones quedan «sin dato».
# También se aceptan los alias del portal: API_KEY y SECRET_KEY (o API_SECRET).
BINANCE_API_KEY=
# Firma HMAC si el portal dio api secret...
BINANCE_API_SECRET=
# ...o la clave privada (PEM en una línea con \n, o ruta al archivo) para RSA/Ed25519:
# BINANCE_PRIVATE_KEY=
# BINANCE_PRIVATE_KEY_PASSPHRASE=
